{
 "background": "b(s) = \\max\\left(1,\\ \\left(\\frac{s}{s_0}\\right)^{\\nu}\\right),\\quad s_0 = 1\\ \\mathrm{kb}",
 "loop_target": "d(s, q) = 1 + \\frac{b(s) - 1}{1 + q},\\quad q = \\frac{n}{\\bar{n}_f(s)}",
 "contact_prob": "P(s) \\propto s^{-3\\nu}",
 "hic_target": "t(s) = b(s) \\left(\\frac{O}{E(s)}\\right)^{-1/3}",
 "anchor_energy": "E_{\\mathrm{anchor}} = \\sum_{(i,j) \\in L} k \\left(\\frac{d_{ij} - t_{ij}}{t_{ij}}\\right)^2 + w_b \\sum_{(i,j) \\in B} \\left(\\frac{d_{ij} - b_{ij}}{\\min(d_{ij}, b_{ij})}\\right)^2 \\qquad + w_g \\sum_{w \\in W} n_w \\left(\\frac{R_g(w)}{R_w} - 1\\right)^2 + w_{ev} \\sum_{|i - j| > 1} \\left(\\frac{r_0 - d_{ij}}{r_0}\\right)_{+}^{2}",
 "chain_energy": "E_{\\mathrm{chain}} = \\sum_i w_d k \\left(\\frac{d_{i,i+1} - t_i}{t_i}\\right)^2 + \\sum_i w_a \\left(\\frac{1 - \\cos\\theta_i}{2}\\right)^3 \\qquad + \\sum_{(i,j) \\in C} w_m \\left(\\frac{1 - \\mathbf{o}_i \\cdot \\mathbf{o}_j}{2}\\right)^2 + w_{ev} \\sum_{|i - j| > 1} \\left(\\frac{r_0 - d_{ij}}{r_0}\\right)_{+}^{2} + w_c \\sum_i \\left(\\frac{r_i - R}{R}\\right)_{+}^{2}",
 "acceptance_plain": "p_{\\mathrm{accept}} = \\min\\left(1,\\ \\exp\\left(-\\frac{c\\, E'}{E\\, T}\\right)\\right)\\quad \\mathrm{for}\\ \\Delta E \\geq 0",
 "t_loop_simple": "k \\left(\\frac{d_{ij} - t_{ij}}{t_{ij}}\\right)^2",
 "t_background": "w_b \\left(\\frac{d_{ij} - b_{ij}}{\\min(d_{ij}, b_{ij})}\\right)^2",
 "t_gyration": "w_g\\, n_w \\left(\\frac{R_g(w)}{R_w} - 1\\right)^2",
 "t_ev": "w_{ev} \\left(\\frac{r_0 - d_{ij}}{r_0}\\right)^2,\\ d_{ij} < r_0",
 "t_bond": "w_d k \\left(\\frac{d_{i,i+1} - t_i}{t_i}\\right)^2",
 "t_bending": "w_a \\left(\\frac{1 - \\cos\\theta_i}{2}\\right)^3",
 "t_orientation": "w_m \\left(\\frac{1 - \\mathbf{o}_i \\cdot \\mathbf{o}_j}{2}\\right)^2",
 "t_confinement": "w_c \\left(\\frac{r_i - R}{R}\\right)^2,\\ r_i > R",
 "loop_kept": "p_{\\mathrm{keep}} = \\frac{q}{q + 1}",
 "node_radius": "r_{ij} = r_0\\, \\frac{f_i + f_j}{2},\\quad f_i = \\left(\\frac{c_i}{\\bar{c}}\\right)^{1/3}",
 "reach": "E_{\\mathrm{reach}} = k \\left(\\frac{d_{ij} - n_{ij}}{n_{ij}}\\right)^2\\ \\mathrm{for}\\ d_{ij} > n_{ij},\\quad 0\\ \\mathrm{otherwise}",
 "cell_test": "z = \\frac{O - E}{\\sqrt{E}},\\quad E = \\bar{E}(s)\\, \\beta_i\\, \\beta_j,\\quad \\mathrm{held\\ when}\\ |z| > 3\\ \\mathrm{and}\\ E > 9",
 "cell_target": "t = b(s) \\left(\\frac{O + 1/2}{E + 1/2}\\right)^{-1/3},\\quad 1 \\leq t \\leq 2.5\\, b(s)",
 "stretch_pairs": "t_{ab} = b(s_{ab})\\quad \\mathrm{for}\\ s_{ab} \\leq 5\\ \\mathrm{Mb}\\ \\mathrm{or}\\ |a - b| \\in \\{2^m,\\ 3 \\cdot 2^m\\}",
 "bond_two": "E_{\\mathrm{bond}} = w_d\\, k \\left(\\frac{d - t}{t}\\right)^2,\\quad k = k_s\\ \\mathrm{for}\\ d > t,\\quad k = k_q\\ \\mathrm{for}\\ d < t",
 "node_move": "\\mathbf{x}_i \\rightarrow \\mathbf{x}_i + \\Delta,\\quad \\mathbf{x}_{i-1} \\rightarrow \\mathbf{x}_{i-1} - \\frac{\\Delta}{2},\\quad \\mathbf{x}_{i+1} \\rightarrow \\mathbf{x}_{i+1} - \\frac{\\Delta}{2}",
 "m_contact": "c_{ij} = \\frac{\\sum_s n^s_{ij}}{B_i\\, B_j},\\quad B_i = \\sum_s b^s_i",
 "m_scc": "\\mathrm{SCC} = \\frac{\\sum_d w_d\\, r_d}{\\sum_d w_d},\\quad w_d = N_d\\, \\sigma_d(c)\\, \\sigma_d(h)",
 "m_distance": "d_{EP} = \\frac{1}{S} \\sum_{s=1}^{S} \\left\\Vert \\mathbf{x}^s_E - \\mathbf{x}^s_P \\right\\Vert",
 "m_expression": "\\rho_{AB} = -\\,\\mathrm{Spearman}_g\\left(R^B_g - R^A_g,\\ \\log_2 \\frac{e^B_g}{e^A_g}\\right)",
 "m_loop": "\\lambda_l = \\frac{d_l}{\\mathrm{median}_k\\ d_{l,k}},\\quad \\mathrm{placed\\ when}\\ \\lambda_l \\leq 0.8",
 "m_placed": "\\mathrm{score} = \\frac{\\mathrm{placed\\ loops}}{\\mathrm{loops}} - \\frac{\\mathrm{placed\\ moved\\ loops}}{\\mathrm{moved\\ loops}}"
}
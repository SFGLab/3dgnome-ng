                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "pJy5q",
                      "name": "Intro",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A variant changes the loops before the structure is built, by the rules of Sadowski and colleagues, Genome Biology 2019.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "K8YW1S",
                      "name": "Rules",
                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
                          "type": "frame",
                          "id": "OddDo",
                          "name": "Rule Deletion",

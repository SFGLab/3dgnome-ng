                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "W1U9nx",
                          "name": "Q",
                          "fill": "$ink",
                          "content": "How long does a job take?",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "t9fObL",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Most regions of 1 Mb finish within minutes. A job waits in the queue while the GPUs are busy; the job page shows its place.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "MFBkk",
                  "name": "Running gnome3d yourself",
                  "width": 760,
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "H0Rua",
                      "name": "Heading",
                      "fill": "$ink",
                      "content": "Running gnome3d yourself",
                      "fontFamily": "$font",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "KGcXu",
                      "name": "Text",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The engine behind this server is a Python package. It runs on a CPU and uses a GPU when one is present.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "QnyjE",
                      "name": "Code",
                      "width": "fill_container",
                      "fill": "#1E1E1C",
                      "cornerRadius": 8,
                      "padding": [
                        12,
                        14
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "q2eUT",
                          "name": "Text",
                          "fill": "#E9E8E3",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "pip install gnome3d-ng\ngnome3d-ng --config config.ini --region chr1:11500000-12600000 -n 10 --out models/",
                          "lineHeight": 1.6,
                          "fontFamily": "$mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }

                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "y8uc4l",
                          "name": "Q",
                          "fill": "$ink",
                          "content": "Why is a gene missing from the table?",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "w0Pog",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Its TSS or its nearest enhancer lies more than 5 kb from every bead. Beads sit only where loops are.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {

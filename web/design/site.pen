                          "name": "Rule Inversion",
                          "width": "fill_container",
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [

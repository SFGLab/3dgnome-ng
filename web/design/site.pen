                    {
                      "type": "text",
                      "id": "vF3rx",
                      "name": "Lead",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "3D-GNOMEᴺᴳ computes 3D structures of a genomic region from chromatin loops and contact maps. Each structure is a chain of beads, about one bead per kilobase. A job returns an ensemble of structures computed from different random starting positions.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]

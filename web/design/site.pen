                          "id": "QuY53",
                          "name": "Q",
                          "fill": "$ink",
                          "content": "Why do the structures differ?",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "p23snF",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Each starts from a different random position. Parts the data fix firmly look alike in every structure; parts they leave open differ.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },

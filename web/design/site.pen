                {
                  "type": "frame",
                  "id": "X4XXf",
                  "name": "Structural variants",
                  "width": 800,
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "vYm2X",
                      "name": "Heading",
                      "fill": "$ink",
                      "content": "Structural variants",
                      "fontFamily": "$font",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "QXOjM",
                      "name": "Intro",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Structural variants change the loop set before modelling. The rules extend those of Sadowski and colleagues, Genome Biology 2019.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "Zw28I",
                      "name": "Rules",
                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
                          "type": "frame",
                          "id": "SNdoI",
                          "name": "Rule Deletion",
                          "width": "fill_container",
                          "height": 151,
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "HAzcx",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Deletion",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "nq4O3",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Anchors inside the deletion are removed with their loops. Positions after it shift by its length.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "l9eeQF",
                          "name": "Rule Insertion",
                          "width": "fill_container",
                          "height": 151,
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "jTitJ",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Insertion",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "n7Gtvz",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The inserted sequence is scanned for CTCF motifs. A motif above the score cutoff becomes an anchor and forms a loop with the nearest anchor in convergent orientation.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "toOJR",
                          "name": "Rule Inversion",
                          "width": "fill_container",
                          "height": 151,
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "lYgsE",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Inversion",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "x9j5tu",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Anchors inside the inversion flip orientation and lose their loops. Each then forms a loop with the nearest anchor in convergent orientation.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }

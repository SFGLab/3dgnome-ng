                  "width": 760,
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "Qjx3R",
                      "name": "Heading",
                      "fill": "$ink",
                      "content": "Your own variants",

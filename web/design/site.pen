                                  "type": "text",
                                  "id": "UsGP1",
                                  "name": "Desc",
                                  "fill": "$muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "All loop anchors of the region are placed together by minimising one energy made of loop springs, the Hi-C contact background and a soft excluded volume. They start on a space filling curve scaled to the distance law.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font",

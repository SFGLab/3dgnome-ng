                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "o7bs0",
                      "name": "Text",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Upload a VCF compressed with bgzip. A record needs SVTYPE of DEL, INS or INV in its INFO field, and END or SVLEN. An insertion uses its ALT sequence when it has one, so CTCF motifs in the inserted sequence can form new anchors. Other variant types are skipped and counted on the result page. A phased genotype puts each allele on its own haplotype.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "cJ709",
                      "name": "Code",
                      "width": "fill_container",
                      "fill": "#1E1E1C",
                      "cornerRadius": 8,

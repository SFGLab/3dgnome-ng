                },
                {
                  "type": "frame",
                  "id": "x8s5P",
                  "name": "Structural variants",
                  "width": 820,
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "mWBgH",
                      "name": "Heading",
                      "fill": "$ink",
                      "content": "7. Structural variants",
                      "fontFamily": "$font",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "aFDf3",
                      "name": "P",
                      "fill": "#3F3E3B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Structural variants change the loops before the anchor phase. The approach comes from Sadowski and colleagues [12], and the rules below extend theirs.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "Zw28I",
                      "name": "Rules",
                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
                          "type": "frame",
                          "id": "SNdoI",
                          "name": "Rule Deletion",
                          "width": "fill_container",
                          "height": 151,
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "HAzcx",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Deletion",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "nq4O3",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Anchors inside the deletion are removed with their loops. Positions after it shift by its length.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "l9eeQF",
                          "name": "Rule Insertion",
                          "width": "fill_container",
                          "height": 151,
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "jTitJ",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Insertion",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "n7Gtvz",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The inserted sequence is scanned for CTCF motifs. A motif above the score cutoff becomes an anchor and forms a loop with the nearest anchor in convergent orientation.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "toOJR",
                          "name": "Rule Inversion",
                          "width": "fill_container",
                          "height": 151,
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "lYgsE",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Inversion",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "x9j5tu",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Anchors inside the inversion flip orientation and lose their loops. Each then forms a loop with the nearest anchor in convergent orientation.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Z6o9Es",
                  "name": "Validation",
                  "width": 820,
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "zJmkQ",
                      "name": "Heading",
                      "fill": "$ink",
                      "content": "8. Validation",
                      "fontFamily": "$font",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "q6Fug5",
                      "name": "P",
                      "fill": "#3F3E3B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A change to the engine becomes the default only after it is measured on GM12878, H1ESC and HFFc6. The measurements are the stratum adjusted correlation with Hi-C [13] at 25 kb, the correlation with Micro-C at 5 kb where a map exists, the exponent of distance against separation, and the number of overlapping beads. A change meant to leave results unchanged is checked by comparing bead coordinates with the previous version. A test against the original 3D-GNOME program compares the distance distributions of both ensembles on a 2 Mb region. The Results page lists the measurements.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "BqsIW",
                  "name": "Limitations",
                  "width": 820,
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "mRV4Z",
                      "name": "Heading",
                      "fill": "$ink",
                      "content": "9. Limitations",
                      "fontFamily": "$font",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "BOn6j",
                      "name": "Cards",
                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
                          "type": "frame",
                          "id": "m68f4w",
                          "name": "Card Population average",
                          "width": "fill_container",
                          "height": 171,
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "G3P7qW",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Population average",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "aEBD0",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Loops and contacts are measured over millions of cells. A structure fits that average and is not the conformation of a single cell. Statistics over the ensemble are more reliable than any one structure.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "V2S7h",
                          "name": "Card Bead units",
                          "width": "fill_container",
                          "height": 171,
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "DYKEf",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Bead units",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "Nonyc",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Distances are in bead units. One unit is the target distance between beads 1 kb apart. Bead units are not nanometres.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "m27OE",
                          "name": "Card No loops, no beads",
                          "width": "fill_container",
                          "height": 171,
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "FrSNO",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "No loops, no beads",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "e8m1B",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Stretches without loops have no beads. Genes there are missing from the distance table.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]

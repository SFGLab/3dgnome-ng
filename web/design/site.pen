                          "name": "Q",
                          "fill": "$ink",
                          "content": "What is a bead unit?",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "NlVxY",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The target distance between two beads 1 kb apart along the chain, which is also the bond length. Distances compare within a job and between jobs of one cell type.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",

                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "w6vHrp",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Deletion",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "cfYou",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Removes every anchor inside it and the loops they form. Loops next to it become shorter.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "Db613",
                          "name": "Rule Insertion",
                          "width": "fill_container",
                          "fill": "$surface",
                          "cornerRadius": 10,
                          "stroke": "$line",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 6,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "sWYtv",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Insertion",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "uVsmL",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The inserted sequence is scanned for CTCF motifs. A motif above the cutoff becomes a new anchor joined to the nearest anchor it can close a convergent loop with.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {

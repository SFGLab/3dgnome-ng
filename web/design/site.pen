                          "id": "y8uc4l",
                          "name": "Q",
                          "fill": "$ink",
                          "content": "Genes missing from the table",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "w0Pog",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The TSS or the nearest enhancer is more than 5 kb from every bead. Beads exist only in stretches with loops.",
                          "lineHeight": 1.55,

                {
                  "type": "frame",
                  "id": "O8GHR9",
                  "name": "Your own variants",
                  "width": 760,
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "Qjx3R",
                      "name": "Heading",
                      "fill": "$ink",
                      "content": "Your own variants",
                      "fontFamily": "$font",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "o7bs0",
                      "name": "Text",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Upload a VCF compressed with bgzip. A record needs SVTYPE of DEL, INS or INV in its INFO field, and END or SVLEN. An insertion uses its ALT sequence when it has one. CTCF motifs in that sequence can become new anchors. The result page counts the skipped records of other types. A phased genotype puts each allele on its own haplotype.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "cJ709",
                      "name": "Code",
                      "width": "fill_container",
                      "fill": "#1E1E1C",
                      "cornerRadius": 8,
                      "padding": [
                        12,
                        14
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "JEnXA",
                          "name": "Text",
                          "fill": "#E9E8E3",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "#CHROM  POS       ID    REF  ALT    QUAL  FILTER  INFO                       FORMAT  HG00733\nchr1    12101200  del1  N    <DEL>  .     PASS    SVTYPE=DEL;END=12118400    GT      0|1\nchr1    12255010  ins1  N    <INS>  .     PASS    SVTYPE=INS;SVLEN=310       GT      1|1\nchr1    12390500  inv1  N    <INV>  .     PASS    SVTYPE=INV;END=12402750    GT      1|0",
                          "lineHeight": 1.6,
                          "fontFamily": "$mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "ApaE0",
                      "name": "Privacy",
                      "fill": "$faint",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An uploaded file and everything built from it are private, reachable only through the job's link, and deleted after 14 days.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }

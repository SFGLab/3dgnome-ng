                    },
                    {
                      "type": "frame",
                      "id": "gWwC7",
                      "name": "QA Can I use Hi-C instead of ChIA-PET?",
                      "width": "fill_container",
                      "stroke": "$line",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "layout": "vertical",
                      "gap": 4,
                      "padding": [
                        10,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "g2vsu",
                          "name": "Q",
                          "fill": "$ink",
                          "content": "Can I use Hi-C instead of ChIA-PET?",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "E3Te17",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "For the contact background, yes, every cell type here uses Hi-C. The loops come from ChIA-PET. Loops called from Hi-C work with the engine run on your own machine.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "SLOIt",
                      "name": "QA Why does HiCDiffusion warn for some cell types?",
                      "width": "fill_container",
                      "stroke": "$line",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "layout": "vertical",
                      "gap": 4,
                      "padding": [
                        10,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "wSBh2",
                          "name": "Q",
                          "fill": "$ink",
                          "content": "Why does HiCDiffusion warn for some cell types?",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "JxxXM",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "HiCDiffusion was trained on GM12878. For other cell types its predicted map is outside what it was trained on.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "YctKm",
                      "name": "QA How long does a job take?",
                      "width": "fill_container",
                      "stroke": "$line",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "layout": "vertical",
                      "gap": 4,
                      "padding": [

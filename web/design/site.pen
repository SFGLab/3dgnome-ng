                        {
                          "type": "text",
                          "id": "qLqPm",
                          "name": "Q",
                          "fill": "$ink",
                          "content": "Bead unit",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "NlVxY",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "One bead unit is the target distance between two beads 1 kb apart, which is also the bond length. You can compare distances within a job and between jobs of one cell type.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "d1mu8",
                      "name": "QA Why is a gene missing from the table?",
                      "width": "fill_container",
                      "stroke": "$line",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "layout": "vertical",

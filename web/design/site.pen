                    {
                      "type": "text",
                      "id": "xLgWT",
                      "name": "Lead",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "gnome3d builds an ensemble of 3D structures of a region from loops measured by ChIA-PET, a contact map measured by Hi-C, and optionally a set of structural variants. Each structure is a chain of beads, one bead every 2 to 6 kb. The structures of an ensemble start from different random positions, so how much they differ shows how firmly the data fix the shape.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },

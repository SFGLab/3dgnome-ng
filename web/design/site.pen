                                {
                                  "type": "text",
                                  "id": "xkYiL",
                                  "name": "Desc",
                                  "fill": "$muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Every pair of anchors gets a target distance. For a pair without a loop the target grows with genomic separation as a power law, with the exponent fitted to the Hi-C of the cell type. For a pair joined by a loop the target shrinks as the loop's read count grows, down to one bead.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
                              ]
                            }

                        14
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "JEnXA",
                          "name": "Text",
                          "fill": "#E9E8E3",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "#CHROM  POS       ID    REF  ALT    QUAL  FILTER  INFO                       FORMAT  HG00733\nchr1    12101200  del1  N    <DEL>  .     PASS    SVTYPE=DEL;END=12118400    GT      0|1\nchr1    12255010  ins1  N    <INS>  .     PASS    SVTYPE=INS;SVLEN=310       GT      1|1\nchr1    12390500  inv1  N    <INV>  .     PASS    SVTYPE=INV;END=12402750    GT      1|0",
                          "lineHeight": 1.6,
                          "fontFamily": "$mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "ApaE0",
                      "name": "Privacy",
                      "fill": "$faint",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An uploaded file and everything built from it are private, reachable only through the job's link, and deleted after 14 days.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]

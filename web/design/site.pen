                              "type": "text",
                              "id": "yJLuw",
                              "name": "Title",
                              "fill": "$ink",
                              "content": "Inversion",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "e3qQH",
                              "name": "Desc",
                              "fill": "$muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Anchors inside it change orientation and lose their loops, then each is joined to the nearest anchor of opposite orientation.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font",

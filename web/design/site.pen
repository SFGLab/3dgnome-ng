                              "fill": "#E9E8E3",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "python web/scripts/make_dataset.py data $DATA_DIR K562 --label \"K562, myelogenous leukaemia\" \\\n  --gtf gencode.v40.basic.annotation.gtf --enhancers K562_enhancers_hg38.bed",
                              "lineHeight": 1.6,
                              "fontFamily": "$mono",
                              "fontSize": 12,

                                  "name": "Desc",
                                  "fill": "$muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Beads between anchors are placed by simulated annealing, figure b. The energy has terms for bond length, bending, CTCF motif orientation and excluded volume. Chains cannot pass through each other. This step runs on the GPU.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }

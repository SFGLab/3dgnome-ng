                                  "name": "Desc",
                                  "fill": "$muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Overlapping loops form a block. The region is split into blocks at points that no loop spans. Stretches with no loop get no beads.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
                              ]
                            }

                      "children": [
                        {
                          "type": "text",
                          "id": "wSBh2",
                          "name": "Q",
                          "fill": "$ink",
                          "content": "HiCDiffusion warning",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "JxxXM",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "HiCDiffusion was trained on GM12878. For other cell types its predicted map is outside its training data.",

                      ]
                    },
                    {
                      "type": "frame",
                      "id": "d1mu8",
                      "name": "QA Why is a gene missing from the table?",
                      "width": "fill_container",
                      "stroke": "$line",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "layout": "vertical",
                      "gap": 4,
                      "padding": [

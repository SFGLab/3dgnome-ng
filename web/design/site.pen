                        {
                          "type": "text",
                          "id": "g2vsu",
                          "name": "Q",
                          "fill": "$ink",
                          "content": "Hi-C instead of ChIA-PET",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "E3Te17",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "You can call loops from Hi-C and upload them as your own loops, with the Hi-C as the contact background. Loops called from Hi-C are noisier than ChIA-PET loops, and structures built from them are noisier too.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "SLOIt",
                      "name": "QA Why does HiCDiffusion warn for some cell types?",
                      "width": "fill_container",
                      "stroke": "$line",

                                  "type": "text",
                                  "id": "b8t70N",
                                  "name": "Desc",
                                  "fill": "$muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Beads between the anchors are arranged by Monte Carlo simulated annealing with chain springs, bending stiffness, CTCF motif orientation and a wall that stops chains passing through each other. This stage runs on the GPU.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }

                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "NlVxY",
                          "name": "A",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The typical distance between two beads 5 kb apart in the same job. Compare distances within a job or between jobs of one cell type.",

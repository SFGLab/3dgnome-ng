                                  "id": "F7z01",
                                  "name": "Desc",
                                  "fill": "$muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "All anchors of the region are positioned in one fit, figure a. The fit minimises loop springs, a Hi-C contact term and a soft repulsion between anchors. It starts from a Hilbert curve scaled to the target distances.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
                              ]
                            }

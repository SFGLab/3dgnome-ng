# The variables of a deployed site, read by docker compose with --env-file. The paths are examples.
# IMAGE is the tag to run. A new deployment changes this line alone.
SITE_ROOT=/srv/3dgnome
BASE_PATH=/new
PORT=8770
GPUS=0,1
WORKERS_PER_GPU=4
GPU_POOL_GIB=1.25
SITE_USER=1000:1000
IMAGE=localhost:5000/gnome3d-web:97da93e4
REGISTRY_ROOT=/srv/3dgnome/registry
REGISTRY_USER=1000:1000

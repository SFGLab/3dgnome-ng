# The variables of the site on team-aragorn, read by docker compose with --env-file.
# IMAGE names the tag to run; a new deployment changes this line alone.
SITE_ROOT=/mnt/raid/3dgnome-new
BASE_PATH=/new
PORT=8770
GPU_SLOTS=0,1
SITE_USER=1010:1011
IMAGE=localhost:5000/gnome3d-web:5e79213
REGISTRY_ROOT=/mnt/raid/3dgnome-new/registry
REGISTRY_USER=1010:1011

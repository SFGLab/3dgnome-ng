# The 2016 to 2025 3D-GNOME site on a supported base. Its own Dockerfile builds on Ubuntu 20.04
# with Python 3.8, Flask 1.1 and MariaDB 10.3 inside the same container, all out of support.
# Here the web layer runs current releases on Python 3.11 and Ubuntu 24.04, and the analysis
# libraries stay at the last releases that behave as the site's code expects, see
# requirements.port.txt. The database is MariaDB's own image beside this one, since Ubuntu's
# package of it has open advisories. cudaMMC links the CUDA runtime statically and needs no CUDA
# libraries in the image, the driver comes from the host.
# Build from a copy of the site's source with apply_port.py applied and these files beside it:
#   docker build -f Dockerfile.port -t 3dgnome_webserver:2026-11-18.2 <the copy>
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04 AS build-cudammc
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake ninja-build \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /home/cudaMMC/cudaMMC
COPY cudaMMC .
RUN rm -rf build && mkdir build && cd build && cmake ../ -DCUDA_ARCH="60;70;75;80;86" -GNinja && ninja

# Ubuntu 24.04 has Python 3.12 alone, and pandas 1.5 has no build for it, so uv brings 3.11.
FROM ubuntu:24.04 AS build-python
ENV DEBIAN_FRONTEND=noninteractive UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv build-essential \
      zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev \
 && rm -rf /var/lib/apt/lists/*
COPY requirements.port.txt .
RUN python3 -m venv /tmp/uv && /tmp/uv/bin/pip install --no-cache-dir uv==0.13.4 \
 && /tmp/uv/bin/uv venv -q --python 3.11 /opt/venv \
 && /tmp/uv/bin/uv pip install -q --no-cache --python /opt/venv/bin/python -r requirements.port.txt \
 && /tmp/uv/bin/uv pip freeze --python /opt/venv/bin/python > /opt/venv/freeze.txt

FROM ubuntu:24.04 AS webservice
ENV TZ=Europe/Warsaw DEBIAN_FRONTEND=noninteractive
WORKDIR /home/3dgnome_webserver
RUN apt-get update && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends parallel bedtools r-base-core r-cran-ggplot2 mawk tzdata \
 && rm -rf /var/lib/apt/lists/*
COPY . .
COPY --from=build-cudammc /home/cudaMMC/cudaMMC/build/cudaMMC /home/3dgnome_webserver/external_scripts/
RUN chmod +x run_container.sh
COPY config.py.dist_local /home/3dgnome_webserver/config.py
ENV PYTHONPATH="/home/3dgnome_webserver"
COPY --from=build-python /opt/uv-python /opt/uv-python
COPY --from=build-python /opt/venv /opt/venv
COPY start-container.port.sh /usr/local/bin/start-container.sh
RUN chmod +x /usr/local/bin/start-container.sh
ENTRYPOINT ["/usr/local/bin/start-container.sh"]
ENV PATH="/opt/venv/bin:$PATH"

# The 2016 to 2025 3D-GNOME site on a supported base: Ubuntu 24.04, Python 3.12, MariaDB 10.11
# and current releases of its Python packages. Its own Dockerfile builds on Ubuntu 20.04 with
# Python 3.8, Flask 1.1 and MariaDB 10.3, all out of support. cudaMMC links the CUDA runtime
# statically and needs no CUDA libraries in the image, the driver comes from the host.
# Build from port/, the copy of the site's source with apply_port.py applied:
#   docker build -f Dockerfile.port -t 3dgnome_webserver:2026-11-18 port
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04 AS build-cudammc
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake ninja-build \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /home/cudaMMC/cudaMMC
COPY cudaMMC .
RUN rm -rf build && mkdir build && cd build && cmake ../ -DCUDA_ARCH="60;70;75;80;86" -GNinja && ninja

FROM ubuntu:24.04 AS build-python
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3.12 python3.12-venv python3-dev build-essential \
      zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libhdf5-dev pkg-config \
 && python3 -m venv /opt/venv
COPY requirements.port.txt .
RUN /opt/venv/bin/pip install --no-cache-dir pip==26.3 \
 && /opt/venv/bin/pip install --no-cache-dir -r requirements.port.txt

FROM ubuntu:24.04 AS webservice
ENV TZ=Europe/Warsaw DEBIAN_FRONTEND=noninteractive
WORKDIR /home/3dgnome_webserver
RUN apt-get update && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends python3 python3.12 mariadb-server parallel bedtools \
      r-base-core r-cran-ggplot2 mawk tzdata \
 && rm -rf /var/lib/apt/lists/*
COPY . .
COPY --from=build-cudammc /home/cudaMMC/cudaMMC/build/cudaMMC /home/3dgnome_webserver/external_scripts/
RUN chmod +x run_container.sh
COPY config.py.dist_local /home/3dgnome_webserver/config.py
ENV PYTHONPATH="/home/3dgnome_webserver"
COPY --from=build-python /opt/venv /opt/venv
COPY start-container.sh /usr/local/bin/start-container.sh
RUN chmod +x /usr/local/bin/start-container.sh
ENTRYPOINT ["/usr/local/bin/start-container.sh"]
ENV PATH="/opt/venv/bin:$PATH"

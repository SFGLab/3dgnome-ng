# Bertrand's documentation, the built pages and the nginx configuration taken from the running
# image and put on the current stable nginx image.
#   docker build -f Dockerfile.docs -t bertrand-docs:2026-11-18 .
FROM bertrand-docs:latest AS old
FROM nginx:1.30.6-alpine
COPY --from=old /usr/share/nginx/html/ /usr/share/nginx/html/
COPY --from=old /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

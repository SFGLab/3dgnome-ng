# The lab page's Python environment on the current Python 3.11 image. The site's code is not
# in the image, the container mounts it. Every package stays in its release series and moves
# to the patch release that clears its advisories, Django 4.2.9 to 4.2.30 for one.
#   docker build -f Dockerfile.web -t labwebpage-web:2026-11-18 .
FROM python:3.11-alpine AS build
RUN apk add --no-cache build-base linux-headers pcre2-dev
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements.bump.txt requirements.bump.txt
RUN pip install --no-cache-dir pip==26.3 && pip install --no-cache-dir -r requirements.bump.txt

FROM python:3.11-alpine
ENV PYTHONUNBUFFERED=1 PATH=/opt/venv/bin:$PATH
COPY --from=build /opt/venv /opt/venv
RUN apk add --no-cache pcre2
RUN set -x ; deluser xfs ; addgroup -g 33 -S www-data ; adduser -u 33 -D -S -G www-data www-data && exit 0 ; exit 1
